.build/
dist/
*.dmg
*.pkg
# 描述文件带着账号的 App ID 和团队名，是本机/CI 的输入不是源码
*.provisionprofile
# 打包产物。App 名带中文且迟早改名（DiskWise），所以按 *.app 通配，不写死名字
build_app/*.app/
build_app/staging/
# 图标是 make_icon.swift 的生成物，build.sh 缺了就重画，不进仓库
build_app/AppIcon.icns
build_app/AppIcon.iconset/
# ARCH=universal 时 lipo 出来的合刀，进 .app 前的中转
build_app/DiskCleaner.universal
# productbuild 的输出日志，只在 pkg 签名失败时给人看最后一行
build_app/productbuild.log
# 本地草稿笔记，还没到能发布的程度，一律不入库
plans/
.DS_Store
build_app/derived/

# 签名材料一律不入库：私钥、证书、CSR、描述文件（profile 里带着 App ID 前缀和团队名）
*.p12
*.py12
*.cer
*.der
*.pem
*.key
*.csr
*.mobileprovision
