.build/
dist/
*.dmg
*.pkg
# 描述文件带着账号的 App ID 和团队名，是本机/CI 的输入不是源码
*.provisionprofile
# 打包产物。App 名带中文且迟早改名（DiskWise），所以按 *.app 通配，不写死名字
build_app/*.app/
build_app/staging/
# 图标是 make_icon.swift 的生成物，build.sh 缺了就重画，不进仓库
build_app/AppIcon.icns
build_app/AppIcon.iconset/
# ARCH=universal 时 lipo 出来的合刀，进 .app 前的中转
build_app/DiskCleaner.universal
# productbuild 的输出日志，只在 pkg 签名失败时给人看最后一行
build_app/productbuild.log
# 本地草稿笔记，还没到能发布的程度，一律不入库
plans/
# 编辑器/agent 的项目内工作数据，只对本机有意义
.workbuddy/
.DS_Store
build_app/derived/

# 签名材料一律不入库：私钥、证书、CSR、描述文件（profile 里带着 App ID 前缀和团队名）
*.p12
*.py12
*.cer
*.der
*.pem
*.key
*.csr
*.mobileprovision

# AOCI agent host integration (machine-bound; do not commit)
.mcp.json
.mcp.json.backup.*
.codex/config.toml
.codex/config.toml.backup.*

# AOCI wire (aoci-wire.sh) — machine-bound, do not commit
.cursor/mcp.json
.cursor/mcp.json.backup.*
.zcode/config.json
.zcode/config.json.backup.*
opencode.json
opencode.json.backup.*
AGENTS.md.backup.*

# ── 开发专用旁路工具：不进发布包、不提交、不 push ──────────────────────
# 下面这些是给「扫描测速」用的独立命令行工具，不是产品功能，build.sh 也不会
# 把它们拷进任何 .app/.dmg/.pkg。留在这儿只为别误提交。
Sources/ScanBench/

# 反例，务必别跟着忽略/搬走：SnapshotMode.swift 看着像「拍宣传图的工具」，
# 其实它是产品的承重结构——19 个界面文件读它的 SnapshotMode.* 静态量
# （此刻是不是在拍图、用哪套皮肤/语言/窗口、冻不冻动画、假家目录）。
# 它随产品编译、已提交，移走或忽略会直接编译失败。真要隔离宣传工具，
# 该拆的是「拍图运行器」那部分（SCShareableContent 抓屏 + 逐页存 PNG），
# 把它挪成独立 target，而 SnapshotMode 的静态开关必须留在 App 里。
